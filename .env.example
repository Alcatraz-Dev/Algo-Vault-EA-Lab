# An unset value reports NOT_CONFIGURED; it never fakes a publication.

# Meta (Instagram Graph API + Facebook Page video uploads)
META_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=

# YouTube Data API v3 (OAuth access token with youtube.upload scope)
YOUTUBE_OAUTH_ACCESS_TOKEN=
YOUTUBE_ACCESS_TOKEN=

# LinkedIn UGC API
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# X API v2 + media upload
X_BEARER_TOKEN=
X_ACCESS_TOKEN=

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=

# ── Optional runtime overrides ─────────────────────────────────────────────
FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Sieve scrape API (https://scrape.usesieve.com) — SERVER-SIDE ONLY.
# The key has full account access and no scopes: never expose it as
# NEXT_PUBLIC_*, never log it, never commit it. Get one with
# `npm run sieve:login` (device login) or Settings → API keys. When
# SIEVE_API_KEY is unset the integration is disabled and fails closed.
SIEVE_API_KEY=
# Optional API base override (defaults to https://scrape.usesieve.com).
SIEVE_BASE_URL=

# ERPNext / Frappe Business Layer (disabled by default; server-only)
ERPNEXT_ENABLED=false
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Optional: signing secret for the V2 thin-event Event Destination. When unset
# the webhook falls back to STRIPE_WEBHOOK_SECRET (sufficient for local
# `stripe listen --thin-events`).
STRIPE_V2_WEBHOOK_SECRET=
# TODO: set to the platform subscription Price ID (price_...) used by the store
# subscription checkout flow via `customer_account` (Android support). The
# current checkout path uses inline price data and does NOT consume this value.
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_CONNECT_URL=
NEXT_PUBLIC_APP_URL=

# CHROME EXTENSION BINDING
# Extension (pack) id used by the site → extension install-id bridge. The site
# mints a durable install id (localStorage) so the extension's free daily
# signal quota survives extension removal/reinstall. Find it at
# chrome://extensions → AlgoVault → ID, then set it here and in the manifest's
# externally_connectable matches if the deployment origin differs.
NEXT_PUBLIC_EXTENSION_ID=

# TELEGRAM BOT (FOR USER ALERTS)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# TELEGRAM USER ACCOUNT CLIENT (ADMIN ONLY FOR SIGNAL INGESTION)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# DISCORD WEBHOOK CHANNEL

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
NEXT_PUBLIC_DISCORD_CLIENT_ID=  # for bot invite link

# TRANSACTIONAL EMAIL (ALERT DELIVERY)
# Set ONE provider key. Resend is used when RESEND_API_KEY is present,
# otherwise SendGrid when SENDGRID_API_KEY is present. EMAIL_FROM must be a
# verified sender/domain (e.g. AlgoVault Alerts <alerts@yourdomain.com>).
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=

# FIRESTORE / DATABASES

# TWELVE DATA (free market data: https://twelvedata.com — free API key)

TWELVE_DATA_API_KEY=

#TRADINGVIEW

TRADINGVIEW_WEBHOOK_SECRET=

# TRADINGVIEW MCP (EXTERNAL INTELLIGENCE PROVIDER — BETA)
# Server-side only. Disabled by default; enabling is fully additive — AlgoVault
# works identically with it off. Never used for execution, the live price feed,
# latency-sensitive scalping, or deterministic backtesting.
TRADINGVIEW_MCP_ENABLED=false
# Capability flags (default ON when the master flag is enabled; set to "false"
# individually to disable a capability).
TRADINGVIEW_MCP_NEWS=true
TRADINGVIEW_MCP_TECHNICALS=true
TRADINGVIEW_MCP_SCREENER=true
TRADINGVIEW_MCP_ECONOMIC_CALENDAR=true
TRADINGVIEW_MCP_FUNDAMENTALS=true
TRADINGVIEW_MCP_WATCHLISTS=true
TRADINGVIEW_MCP_ALERTS=true
# OAuth 2.1 client for mcp.tradingview.com/mcp. Server-side OAuth metadata
# discovery is attempted first (RFC 8707 protected-resource → RFC 8414
# authorization-server metadata); when no client id is set, the app registers
# one dynamically (RFC 7591) and stores it in RTDB tradingviewMcp/clientRegistration.
# These env vars remain the explicit fallback (and the way to pin endpoints).
# Never NEXT_PUBLIC_*.
TRADINGVIEW_MCP_CLIENT_ID=
# Scopes requested during authorization. Defaults to the server's advertised
# read-only scope (currently `mcp:read`); set e.g. "mcp:read mcp:tools" if the
# account requires the tool scope for read-only tool calls. Space/comma separated.
TRADINGVIEW_MCP_SCOPES=
TRADINGVIEW_MCP_CLIENT_SECRET=
TRADINGVIEW_MCP_AUTHORIZATION_ENDPOINT=
TRADINGVIEW_MCP_TOKEN_ENDPOINT=
TRADINGVIEW_MCP_REVOCATION_ENDPOINT=
# AES-256-GCM key material used to encrypt per-user TradingView OAuth tokens
# at rest in RTDB (32-byte hex, or any passphrase >= 32 chars). REQUIRED for
# the integration to operate; with it unset the provider refuses to store or
# use tokens (fail-closed). Rotate by re-connecting users.
TRADINGVIEW_TOKEN_ENCRYPTION_KEY=

# GATEWAY SECRET
GATEWAY_SECRET=


# FREE MULTI-PROVIDER AI GATEWAY
AI_FREE_ONLY=true
AI_DEFAULT_PROVIDER=openrouter
AI_DEFAULT_MODEL=openrouter/free
AI_MAX_PROVIDER_ATTEMPTS=4
AI_REQUEST_TIMEOUT_MS=30000

GEMINI_API_KEY=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

BAI_API_KEY=
BAI_BASE_URL=https://api.b.ai/v1

# Server-side only. Never expose as NEXT_PUBLIC_* — it is read exclusively by
# lib/ai/providers/codecraft.ts on the server. Leave empty to disable CodeCraft.
CODECRAFT_API_KEY=
CODECRAFT_BASE_URL=https://www.codecraftapi.com/v1
# A real model id from CodeCraft's GET /models catalog. There is NO default and
# no placeholder: if this is empty the provider resolves a real catalog model,
# and if none is available it fails with a configuration error rather than
# sending an invented id. (A live check confirmed "codecraft-default" is not a
# real model and is never sent upstream.)
CODECRAFT_MODEL=deepseek-v4-flash-0731
# Per-PROVIDER cost opt-in. CodeCraft bills per token — a live /models check
# returned non-zero pricing for all 33 catalog models — so with AI_FREE_ONLY=true
# (the default) every CodeCraft model is blocked. Setting this to "true" allows
# metered models for CODECRAFT ONLY; AI_FREE_ONLY itself is never modified, so
# Gemini/OpenRouter/OpenCode/B.AI/Bytez keep their existing protection.
# Leave unset/false to keep CodeCraft fully disabled under the free-only policy.
CODECRAFT_ALLOW_METERED=

# AI USAGE & BUDGET CONTROL
# Every AI request is metered server-side (provider, model, tokens, latency,
# status, estimated cost) and aggregated daily + monthly on Firebase RTDB.
# NO prompt, completion, header or API key is ever persisted. Budgets are
# checked BEFORE each provider call, so a limit is never discovered to be
# exceeded only after the tokens were already spent.
#
# Leave every limit EMPTY to keep enforcement inert (usage is still tracked).
# Per-user and per-plugin limits are configured in the admin UI
# (Admin -> Intelligence -> AI Usage & Budgets) and stored in RTDB; they have no
# env equivalent because their keyspace is unbounded.
#
# GLOBAL monthly budget. Both are optional and independent.
GLOBAL_AI_MONTHLY_TOKEN_LIMIT=
GLOBAL_AI_MONTHLY_BUDGET_USD=
#
# PER-PROVIDER monthly budget, discovered by convention: AI_PROVIDER_<ID>_...
# e.g. AI_PROVIDER_CODECRAFT_MONTHLY_TOKEN_LIMIT=2000000
AI_PROVIDER_CODECRAFT_MONTHLY_TOKEN_LIMIT=
AI_PROVIDER_CODECRAFT_MONTHLY_BUDGET_USD=
#
# ALLOW / WARN / BLOCK thresholds as a fraction of the limit. Under 0.8 = ALLOW,
# 0.8-0.99 = ALLOW with a warning, >= 1.0 = BLOCK. A provider blocked by budget
# is skipped and the next allowed provider runs; if every provider is blocked
# the request degrades to the free local heuristic and reports
# AI_BUDGET_EXCEEDED. The global budget is re-checked for every candidate
# provider, so fallback can never bypass it.
AI_BUDGET_WARN_THRESHOLD=0.8
AI_BUDGET_BLOCK_THRESHOLD=1.0
# How long a resolved budget configuration is cached before re-reading RTDB.
AI_BUDGET_CONFIG_TTL_MS=15000
# Days of raw per-request events to keep. Aggregates are never pruned.
AI_USAGE_EVENT_RETENTION_DAYS=90
# How long the model-catalog snapshot used for COST ESTIMATION is cached.
# Cost is estimated from the pricing each provider's own catalog reports; if no
# snapshot is warm a request records an UNKNOWN cost rather than a guess, and the
# UI shows "Cost unavailable". Token budgets are always exact.
AI_PRICING_CATALOG_TTL_MS=1800000

#RAEL TIME MARKET PRICE
REALMARKET_API_KEY=

# PLUGINS & EXTENSIONS ECOSYSTEM
# Secret shared between the Vercel cron trigger and /api/plugins/runtime/tick.
# Set this to a long random string in production, and add the same value as a
# header (x-cron-secret) whenever the endpoint is invoked.
PLUGIN_RUNTIME_CRON_SECRET=

# CRON / SCHEDULED ENDPOINTS
# Shared secret required by /api/signals/auto-update, /api/pro-signals/auto-update,
# /api/ai-signals/monitor, /api/alerts/check and /api/trade-management/monitor
# (x-cron-secret header or ?secret=), or Vercel's cron runner UA. Must be a long
# random string in production; endpoints fail closed when it is unset.
CRON_SECRET=

# TELEGRAM SIGNAL INGESTION WEBHOOK
# /api/telegram-signals/webhook only runs when TELEGRAM_INGESTION_SECRET is set
# (Authorization: Bearer <secret> or ?secret=). Set to a long random string.
TELEGRAM_INGESTION_SECRET=
# Local-only: set to 1 to allow unauthenticated ingestion in development.
TELEGRAM_INGESTION_ALLOW_DEV=

# AI Plugin Studio uses the same multi-provider AI gateway as the rest of the
# app (AI_FREE_ONLY / AI_DEFAULT_PROVIDER / model keys above). In production,
# prefer a paid provider such as GEMINI_API_KEY or OPENROUTER_API_KEY so that
# generated plugin drafts are not throttled by the free tier.

# ======== BYTEZ (ADDED) ========
# Bytez model API (https://api.bytez.com) — server-side only, never client-facing.
# Credit-based service: the Authorization header is the RAW key (no "Bearer" prefix).
# Open models <=7B are free-eligible on the Free plan; models whose list entry
# meter ends in "-free" are the only ones treated as free by the AI router.
BYTEZ_API_KEY=

# GROWTH / MONETIZATION ENV
# AdSense (web only — never use AdMob in Next.js web app):
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
ADSENSE_ENABLED=false
# AdMob (iOS/Android native apps only — not for Next.js web):
# ADMOB_APP_ID=
# ADMOB_AD_UNIT_ID=
# Channel credentials (server-side only; never expose to frontend):
GROWTH_EMAIL_RECIPIENTS=
GROWTH_EMAIL_SMTP_HOST=
GROWTH_DISCORD_WEBHOOK_URL=
GROWTH_BLOG_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# AI TRADING TEAMS (Pro feature) — staged rollout / rollback flags
# Documentation: docs/ai-trading-teams.md
# Values false/0/off/no/disabled disable a flag; missing = enabled.
# ─────────────────────────────────────────────────────────────────────────────
# AI_TRADING_TEAMS_ENABLED=true
# AI_CUSTOM_AGENTS_ENABLED=true
# AI_ADMIN_AGENT_FACTORY_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# PERFORMANCE ARENA (simulated prop-style challenges) — server-only flags
# Documentation: docs/PERFORMANCE_ARENA.md, docs/FUTURE_CASH_REWARDS.md
# Read server-side only (lib/performance-arena/flags.ts); no API route or
# admin UI accepts them as input. Values false/0/off/no/disabled disable a
# flag; missing = the default shown below.
# ─────────────────────────────────────────────────────────────────────────────
# Trading capabilities (server-side only; unreleased capabilities are hard-off)
# ENABLE_PAPER_TRADING=true
# ENABLE_CHALLENGES=false
# ENABLE_BROKER_CONNECTIONS=false
# ENABLE_LIVE_TRADING=false
# ENABLE_FUNDED_PROGRAM=false
# ENABLE_PAYOUTS=false
#
# ─────────────────────────────────────────────────────────────────────────────
# UNIFIED TRADING SERVICE (provider-neutral execution layer)
# Documentation: docs/architecture/UNIFIED_TRADING.md
#
# Execution mode. DEMO is the only supported mode; any other value disables
# ALL execution (fail-closed) rather than guessing.
# TRADING_EXECUTION_MODE=DEMO
#
# Provider capability flags (server-side only, never NEXT_PUBLIC).
# UNIFIED_TRADING_ENABLED=true
# MT5_DEMO_ENABLED=true
#
# The following providers are architecture-only. They are hard-off: no
# environment variable can enable them in this phase.
#   MT4_DEMO_ENABLED          → false
#   CTRADER_DEMO_ENABLED      → false
#   TRADINGVIEW_EXECUTION_ENABLED → false
#   ALGOVAULT_BROKER_ENABLED  → false
#   LIVE_TRADING_ENABLED      → not a flag; always false (hard disabled)
#
# MT5 gateway (AlgoVaultTradeGateway EA) transport tuning.
# The EA posts to <PLATFORM_URL>/api/trading/gateway/* with a per-user bearer
# token minted at /api/trading/gateway/token. No broker credentials ever reach
# AlgoVault — the EA runs locally inside the user's MT5 terminal.
# MT5_GATEWAY_URL=https://algovault.com
# MT5_GATEWAY_HEARTBEAT_INTERVAL_SECONDS=15
#
# Connection lifecycle thresholds (milliseconds).
# UNIFIED_TRADING_HEARTBEAT_STALE_MS=90000
# UNIFIED_TRADING_HEARTBEAT_DEGRADED_MS=45000
#
# Execution verification. The service waits for the gateway's execution
# report, then verifies the ticket against synced account state.
# UNIFIED_TRADING_EXECUTION_TIMEOUT_MS=20000
# UNIFIED_TRADING_EXECUTION_POLL_MS=750
#
# PERFORMANCE_ARENA_ENABLED=true
# ARENA_CATALOG_ENABLED=true
# ARENA_PAID_CHALLENGES_ENABLED=false
# ARENA_STRIPE_BILLING_VERIFIED=false  # only true after a live Stripe + webhook test
# ARENA_LEADERBOARDS_ENABLED=true
# ARENA_PLATFORM_REWARDS_ENABLED=true
# CASH_REWARDS_ENABLED=false   # MUST stay false in production — cash rewards
#                              # are structurally disabled; enabling this env
#                              # alone activates nothing (no provider, no flow).

# ─────────────────────────────────────────────────────────────────────────────
# UNIFIED AI INTELLIGENCE FABRIC ("AlgoVault Intelligence Fabric")
# Documentation: docs/INTELLIGENCE_FABRIC.md
#
# Server-side only. Every component is independently killable; with all flags
# at defaults and NO provider keys configured, the fabric is inert: AI stages
# degrade to honest AI_UNAVAILABLE states and every deterministic engine
# (market intelligence, signals, backtests, workflows, risk engine) keeps
# running unchanged.
# Values false/0/off/no/disabled disable a flag; missing = default shown.
# ─────────────────────────────────────────────────────────────────────────────

# ── Feature flags (rollback switches) ────────────────────────────────────────
# Master switch. false disables every fabric surface at once.
UNIFIED_AI_INTELLIGENCE=true
# Jev structured decision/validation layer (inert until JEV_API_* or a Jev-
# capable provider is configured; AI_JEV_POLICY then governs pipeline behavior).
JEV_DECISION_ENGINE=true
# Free-provider-aware routing on top of the existing AI gateway.
FREE_LLM_ROUTER=true
# Task-aware multi-model routing (different models per task profile).
MULTI_MODEL_ROUTING=true
# AI Challenge Review (Performance Arena behavior narrative — advisory only).
AI_CHALLENGE_REVIEW=true
# AI strategy-research assessment (interpretation-only over deterministic metrics).
AI_STRATEGY_RESEARCH=true
# Pro Scalping Terminal intelligence panel + decision state.
AI_PRO_SCALPING_INTELLIGENCE=true
# Persist decision/request audits to RTDB ai/decisions + ai/requests.
AI_INTELLIGENCE_AUDIT=true

# ── New free-tier providers (OpenAI-compatible; server-side only) ────────────
# Adapters are wired but NOT live-tested until a key is configured. Model
# catalogs are fetched from each provider's own /models endpoint — never
# hardcoded. Per-provider kill switches: AI_PROVIDER_<ID>_DISABLED=1
# (e.g. AI_PROVIDER_GROQ_DISABLED=1).
GROQ_API_KEY=
GROQ_BASE_URL=
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=
MISTRAL_API_KEY=
MISTRAL_BASE_URL=

# ── Optional premium provider (never mandatory) ──────────────────────────────
# Claude is routed only when the request policy allows paid providers
# (admin tier / allowPaidFallback / Pro deep tasks). Without a key it is
# simply never routed. Kill switch: AI_PROVIDER_CLAUDE_DISABLED=1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ── Jev dedicated endpoint (optional) ────────────────────────────────────────
# When both are set the fabric POSTs the compact MarketIntelligenceContext and
# expects the structured Jev JSON schema. Without them Jev falls back to a
# strictly-schema-validated LLM profile through the unified router; if that
# also fails, Jev reports UNAVAILABLE (never a fabricated decision).
JEV_API_URL=
JEV_API_KEY=
JEV_TIMEOUT_MS=8000
# How pipelines proceed when Jev is unavailable: strict (default) blocks
# execution-adjacent decisions; degraded continues marked DEGRADED with
# confidence capped at 60.
AI_JEV_POLICY=strict

# ── Jev agent skill (jev-ai/jev-agent-skill) ─────────────────────────────────
# Optional response language: en-US or zh-CN; default en-US.
JEV_LANGUAGE=en-US
# Optional API origin; default https://thejevai.com
JEV_API_BASE_URL=https://thejevai.com
# Optional model id; default typesafe/jev-1.13
JEV_MODEL=typesafe/jev-1.13

# Pro Scalping Terminal decision cache. Every orchestration spends scarce
# free-tier AI quota, so a decision is reused per symbol+timeframe for this
# long (AI_UNAVAILABLE results are cached for only 30s so recovery is quick).
# Missing/0 = the default 180000 (3 min).
AI_SCALPING_DECISION_TTL_MS=

# ── Router tuning ────────────────────────────────────────────────────────────
# Circuit breaker: consecutive failures before a provider is opened, and the
# base cooldown (exponential backoff ×2, capped at 10 minutes).
AI_HEALTH_OPEN_AFTER_FAILURES=3
AI_HEALTH_COOLDOWN_MS=30000
