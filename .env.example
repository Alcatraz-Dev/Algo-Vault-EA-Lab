# FIREBASE ENV

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# FIREBASE ADMIN SDK ENV

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# STRIPE ENV

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: signing secret for the V2 thin-event Event Destination. When unset
# the webhook falls back to STRIPE_WEBHOOK_SECRET (sufficient for local
# `stripe listen --thin-events`).
STRIPE_V2_WEBHOOK_SECRET=
# TODO: set to the platform subscription Price ID (price_...) used by the store
# subscription checkout flow via `customer_account` (Android support). The
# current checkout path uses inline price data and does NOT consume this value.
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_CONNECT_URL=
NEXT_PUBLIC_APP_URL=

# TELEGRAM BOT (FOR USER ALERTS)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# TELEGRAM USER ACCOUNT CLIENT (ADMIN ONLY FOR SIGNAL INGESTION)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# DISCORD WEBHOOK CHANNEL

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
NEXT_PUBLIC_DISCORD_CLIENT_ID=  # for bot invite link

# TRANSACTIONAL EMAIL (ALERT DELIVERY)
# Set ONE provider key. Resend is used when RESEND_API_KEY is present,
# otherwise SendGrid when SENDGRID_API_KEY is present. EMAIL_FROM must be a
# verified sender/domain (e.g. AlgoVault Alerts <alerts@yourdomain.com>).
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=

# FIRESTORE / DATABASES

# TWELVE DATA (free market data: https://twelvedata.com — free API key)

TWELVE_DATA_API_KEY=

#TRADINGVIEW

TRADINGVIEW_WEBHOOK_SECRET=

# GATEWAY SECRET
GATEWAY_SECRET=


# FREE MULTI-PROVIDER AI GATEWAY
AI_FREE_ONLY=true
AI_DEFAULT_PROVIDER=openrouter
AI_DEFAULT_MODEL=openrouter/free
AI_MAX_PROVIDER_ATTEMPTS=4
AI_REQUEST_TIMEOUT_MS=30000

GEMINI_API_KEY=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

BAI_API_KEY=
BAI_BASE_URL=https://api.b.ai/v1

#RAEL TIME MARKET PRICE
REALMARKET_API_KEY=

# PLUGINS & EXTENSIONS ECOSYSTEM
# Secret shared between the Vercel cron trigger and /api/plugins/runtime/tick.
# Set this to a long random string in production, and add the same value as a
# header (x-cron-secret) whenever the endpoint is invoked.
PLUGIN_RUNTIME_CRON_SECRET=

# CRON / SCHEDULED ENDPOINTS
# Shared secret required by /api/signals/auto-update, /api/pro-signals/auto-update,
# /api/ai-signals/monitor, /api/alerts/check and /api/trade-management/monitor
# (x-cron-secret header or ?secret=), or Vercel's cron runner UA. Must be a long
# random string in production; endpoints fail closed when it is unset.
CRON_SECRET=

# TELEGRAM SIGNAL INGESTION WEBHOOK
# /api/telegram-signals/webhook only runs when TELEGRAM_INGESTION_SECRET is set
# (Authorization: Bearer <secret> or ?secret=). Set to a long random string.
TELEGRAM_INGESTION_SECRET=
# Local-only: set to 1 to allow unauthenticated ingestion in development.
TELEGRAM_INGESTION_ALLOW_DEV=

# AI Plugin Studio uses the same multi-provider AI gateway as the rest of the
# app (AI_FREE_ONLY / AI_DEFAULT_PROVIDER / model keys above). In production,
# prefer a paid provider such as GEMINI_API_KEY or OPENROUTER_API_KEY so that
# generated plugin drafts are not throttled by the free tier.

# ======== BYTEZ (ADDED) ========
# Bytez model API (https://api.bytez.com) — server-side only, never client-facing.
# Credit-based service: the Authorization header is the RAW key (no "Bearer" prefix).
# Open models <=7B are free-eligible on the Free plan; models whose list entry
# meter ends in "-free" are the only ones treated as free by the AI router.
BYTEZ_API_KEY=
