# ─────────────────────────────────────────────────────────────────────────────
# MARKETING AGENT (autonomous marketing employee)
# Documentation: docs/marketing-agent/architecture.md
#
# required   = the subsystem fails closed (NOT_CONFIGURED) without it
# optional   = the subsystem degrades gracefully
# dev        = safe defaults for local development
# production = must be set before enabling the feature flag
# ─────────────────────────────────────────────────────────────────────────────

# [required | production] Secret accepted by /api/growth/cron/marketing-agent
# and /api/growth/cron/[job]. Without it the scheduled publish tick never runs.
CRON_SECRET=

# [required | production] Absolute URL of the deployment. Used as the browser
# capture base URL and as the default CTA host. Never a secret.
NEXT_PUBLIC_APP_URL=

# [optional | dev] Server-side workspace where Hypit projects, captures and
# renders are written. Must be writable by the worker process.
MARKETING_AGENT_WORKSPACE=/tmp/marketing-agent

# [optional | production] Feature flags (true/false). All default to safe values;
# the admin UI (Growth → Marketing Agent → Settings) is authoritative at runtime.
MARKETING_AGENT_ENABLED=true
MARKETING_AGENT_BROWSER_CAPTURE_ENABLED=true
MARKETING_AGENT_PUBLISHING_ENABLED=false

# [optional] Set to false to disable Hypit production without touching Growth,
# Marketing Factory or the workflow engine (rollback flag).
MARKETING_HYPIT_ENABLED=true

# [optional | production] Hypit executable. Pin the version — see
# docs/marketing-agent/hypit-setup.md. Never rely on an unpinned `latest`.
HYPIIIT_CLI_PATH=

# [optional] Browser capture runtime. Configure ONE of:
#   HYPIIIT_CLI_PATH  → delegate capture to Hypit's browser runtime (preferred)
#   (playwright installed as a project dependency) → local Chromium capture
MARKETING_BROWSER_CAPTURE_ENABLED=true

# [optional] Base URL the capture browser opens (defaults to NEXT_PUBLIC_APP_URL).
MARKETING_CAPTURE_BASE_URL=

# ── Social connectors (§63/§64) ───────────────────────────────────────────
