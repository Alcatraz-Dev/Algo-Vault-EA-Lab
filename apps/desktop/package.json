{
  "name": "algovault-desktop",
  "displayName": "AlgoVault",
  "description": "Desktop shell for AlgoVault: window chrome, native menus, tray, auto-updater and feed-connection overlay on top of the existing Next.js web app.",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "compiled/main/main.js",
  "scripts": {
    "dev": "ALGOVAULT_DEV=1 tsx src/main/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:next": "NEXT_OUTPUT_STANDALONE=1 next build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "lint": "eslint src --ext .ts,.tsx",
    "package:mac": "npm run build && electron-builder --mac --arm64 --publish=never",
    "package:win": "npm run build && electron-builder --win --publish=never",
    "dist": "npm run build && electron-builder --mac --arm64 --dir --publish=never"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "electron": "36.0.0",
    "electron-builder": "^26.4.5",
    "eslint": "^9.39.5",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  },
  "author": "AlgoVault",
  "build": {
    "electronVersion": "36.0.0",
    "appId": "com.algovault.desktop",
    "productName": "AlgoVault",
    "directories": {
      "output": "dist/desktop-build",
      "buildResources": "public"
    },
    "files": [
      "compiled/main/**/*",
      "compiled/preload/**/*",
      "compiled/shared/**/*",
      "public/icons/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "*.node"
    ],
    "extraResources": [
      {
        "from": "../../.next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "!**/.next/node_modules/**"
        ]
      },
      {
        "from": "../../.next/standalone/node_modules",
        "to": "standalone/node_modules"
      },
      {
        "from": "../../.next/standalone/.next/node_modules",
        "to": "standalone/.next/node_modules"
      },
      {
        "from": "../../.next/static",
        "to": "standalone/.next/static"
      },
      {
        "from": "../../public",
        "to": "standalone/public"
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "public/icons/icon-512x512.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "AlgoVault-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icons/icon-512x512.png",
      "artifactName": "AlgoVault-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Finance"
    },
    "publish": {
      "provider": "github",
      "repo": "Alcatraz-Dev/Algo-Vault-EA-Lab",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "perMachine": false
    }
  }
}
