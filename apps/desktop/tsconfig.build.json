{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "compiled",
    "declaration": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src"
  },
  "include": ["src/main", "src/shared", "src/preload"],
  "exclude": ["src/components", "src/renderer", "**/*.test.ts", "**/*.test.tsx"]
}