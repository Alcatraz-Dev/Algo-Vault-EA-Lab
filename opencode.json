{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "reui": {
      "type": "remote",
      "url": "https://mcp.reui.io",
      "enabled": true,
      "headers": {
        "Authorization": "{env:REUI_MCP_AUTHORIZATION}"
      }
    },
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    }
  }
}
