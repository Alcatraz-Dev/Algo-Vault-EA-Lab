{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // chrome-extension is a self-contained Vite project with its own tsconfig
    // (`@/*` → `src/*`) and its own typecheck/build. Excluding it keeps the
    // root Next.js typecheck from resolving its aliases as if they lived at
    // the repo root. Verify with: cd chrome-extension && npm run typecheck.
    "chrome-extension",
    // packages/shared (@algovault/shared) is a standalone mobile/Expo package
    // with its own package.json, node_modules and `npm run typecheck`. It
    // depends on react-native-only modules (react-native, async-storage,
    // firebase/auth/react-native) that do not exist in this web app's
    // dependency tree, so the root Next.js typecheck must not descend into it.
    // Verify with: cd packages/shared && npm run typecheck.
    "packages/shared",
    // e2e is a self-contained Playwright smoke suite driven by the Playwright
    // binary installed under chrome-extension/node_modules. The root Next.js
    // typecheck cannot resolve `@playwright/test` here, so exclude it from the
    // root typecheck (it is typechecked when the e2e runner invokes tsc).
    "e2e"
  ]
}
